{
  "functions": [
    {
      "codebase": "client-access",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "test-build"
      ],
      "source": "functions"
    }
  ],
  "firestore": [
    {
      "database": "(default)",
      "rules": "firestore.rules",
      "indexes": "firestore.indexes.json"
    },
    {
      "database": "UNCONFIGURED_CABOHEALTH_REVIEW_DATABASE_ID",
      "rules": "firestore.review.rules",
      "indexes": "firestore.review.indexes.json"
    }
  ]
}
