rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // All app and admin traffic must use a trusted server boundary. The
    // Firebase Admin SDK bypasses these client rules; mobile and web SDKs do
    // not receive direct access, even when Firebase Auth is present.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
