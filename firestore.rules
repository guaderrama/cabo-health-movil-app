rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // All app and admin traffic must use a trusted server boundary. The
    // Firebase Admin SDK in Cloud Functions bypasses these client rules;
    // mobile and web SDKs receive no direct catalog, code, grant, rate-limit,
    // audit, or administrative access, even when Firebase Auth is present.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
