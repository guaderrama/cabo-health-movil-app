{
  "name": "cabohealth",
  "version": "2.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:dev": "eas build --platform ios --profile development",
    "build:preview": "eas build --platform ios --profile preview",
    "build:prod": "eas build --platform ios --profile production",
    "submit": "eas submit --platform ios",
    "update": "eas update",
    "lint": "expo lint",
    "test": "node node_modules/typescript/bin/tsc --project tsconfig.node-tests.json && node --test tests/*.test.mjs",
    "test:scope": "node scripts/verify-minimal-v1.mjs",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "expo:config": "node node_modules/expo/bin/cli config --type public --json",
    "miniapps:build": "node scripts/build-miniapps.mjs --release",
    "miniapps:build:healthy": "node scripts/build-miniapps.mjs --healthy",
    "miniapps:serve": "node scripts/serve-miniapps.mjs",
    "miniapps:verify": "node --test tests/miniapps-content.test.mjs tests/miniapps-build.test.mjs",
    "web:assemble:check": "node scripts/assemble-web-release.mjs --check",
    "web:assemble": "node scripts/assemble-web-release.mjs --assemble",
    "web:verify:check": "node scripts/verify-production.mjs --check",
    "web:test": "node --test tests/web-release-assembly.test.mjs tests/web-release-review-fixes.test.mjs tests/production-verifier.test.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~54.0.32",
    "expo-blur": "~15.0.8",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-haptics": "~15.0.8",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.11",
    "expo-network": "~8.0.8",
    "expo-router": "~6.0.22",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.16",
    "firebase": "^12.8.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "^2.30.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-screens": "^4.20.0",
    "react-native-svg": "^15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "^0.7.2",
    "react-refresh": "^0.18.0"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.1.0",
    "babel-preset-expo": "^54.0.10",
    "typescript": "~5.9.2"
  },
  "private": true
}
