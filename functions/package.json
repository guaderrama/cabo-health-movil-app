{
  "name": "cabohealth-secure-functions",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "scripts": {
    "bootstrap:firebase": "npm run build && node lib/tools/bootstrapFirebase.js",
    "migrate:catalog": "npm run build && node lib/tools/migrateCatalog.js",
    "build": "tsc --project tsconfig.json",
    "test": "tsc --project tsconfig.test.json && node --test test-build/tests/**/*.test.js"
  },
  "dependencies": {
    "firebase-admin": "14.3.0",
    "firebase-functions": "7.3.2"
  },
  "devDependencies": {
    "typescript": "5.9.2"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.5",
    "qs": "6.16.0",
    "uuid@^9.0.0": "11.1.1",
    "brace-expansion@^2.0.0": "2.1.7"
  }
}
