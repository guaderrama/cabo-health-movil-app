{
  "name": "@cabohealth/staff-portal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:release": "vite build --mode staff-release",
    "preview": "vite preview",
    "release:artifact": "node scripts/create-release-artifact.mjs",
    "release:verify-artifact": "node scripts/verify-release-artifact.mjs",
    "release:verify-live": "node scripts/verify-live-release.mjs",
    "test": "tsc --project tsconfig.test.json && vite build && node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit --project tsconfig.json"
  },
  "dependencies": {
    "firebase": "12.8.0",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@types/node": "25.0.10",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.5"
  }
}
